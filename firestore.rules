rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: each user reads/writes only their own doc + subcollections ──
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Orders (top-level): any logged-in user can create their own order ──
    match /orders/{orderId} {
      // Customer can create an order (must include their userId)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Customer can read their own orders
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Only write allowed otherwise is via backend (no update from frontend needed here)
      allow update, delete: if false;
    }

    // ── Products (ratings subcollection) ──
    match /products/{productId} {
      allow read: if true;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if request.auth != null;
      }
    }

  }
}
